# Copy to .env and fill locally. Never commit .env (it is gitignored).

# --- analysis pipeline (local only) ---
# Earthdata Login: prefer ~/.netrc (machine urs.earthdata.nasa.gov login <user> password <pass>)
EARTHDATA_TOKEN=
# TypeSafe / Jev evidence check, offline pipeline only; never deployed
TYPESAFE_API_KEY=

# --- api (Cloud Run reads these from Secret Manager in production) ---
EDL_TOKEN_SECRET=projects/solmate-13571/secrets/edl-token/versions/latest
OFFLINE=0

# --- web (public build-time values; the Firebase web config is not secret) ---
VITE_OFFLINE=0
VITE_FIREBASE_PROJECT_ID=solmate-13571
VITE_APPCHECK_SITE_KEY=
