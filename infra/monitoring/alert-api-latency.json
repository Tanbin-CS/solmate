{
  "displayName": "SolMate API slow (p95 over 10 s)",
  "documentation": { "content": "95% of terrain API requests took longer than 10 s for 15 minutes. NASA LP DAAC may be slow; cached places still answer fast. See docs/RUNBOOK.md (API slow).", "mimeType": "text/markdown" },
  "combiner": "OR",
  "conditions": [{
    "displayName": "p95 latency",
    "conditionThreshold": {
      "filter": "metric.type=\"run.googleapis.com/request_latencies\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"solmate-terrain\"",
      "aggregations": [{ "alignmentPeriod": "300s", "perSeriesAligner": "ALIGN_PERCENTILE_95", "crossSeriesReducer": "REDUCE_MAX" }],
      "comparison": "COMPARISON_GT",
      "thresholdValue": 10000,
      "duration": "900s",
      "trigger": { "count": 1 }
    }
  }],
  "alertStrategy": { "autoClose": "3600s" }
}
