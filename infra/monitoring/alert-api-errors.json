{
  "displayName": "SolMate API errors (5xx)",
  "documentation": { "content": "The terrain API returned more than 5 server errors in 10 minutes. Check Cloud Run logs for solmate-terrain; see docs/RUNBOOK.md (API errors).", "mimeType": "text/markdown" },
  "combiner": "OR",
  "conditions": [{
    "displayName": "5xx responses",
    "conditionThreshold": {
      "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"solmate-terrain\" AND metric.label.response_code_class=\"5xx\"",
      "aggregations": [{ "alignmentPeriod": "600s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM" }],
      "comparison": "COMPARISON_GT",
      "thresholdValue": 5,
      "duration": "0s",
      "trigger": { "count": 1 }
    }
  }],
  "alertStrategy": { "autoClose": "3600s" }
}
